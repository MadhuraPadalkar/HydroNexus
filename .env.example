# HydroNexus Environment Configuration
# Frontends
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_USE_MOCKS=true

# Officer Portal
OFFICER_PORT=5173

# Citizen Portal
CITIZEN_PORT=5174

# Backend Service
BACKEND_PORT=8000
DATABASE_URL=postgres://hydronexus_user:hydronexus_password@localhost:5432/hydronexus_db
JWT_SECRET=super_secret_development_jwt_secret_key_32_bytes_long
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Database container overrides (docker compose)
DB_PORT=5432
DB_USER=hydronexus_user
DB_PASSWORD=hydronexus_password
DB_NAME=hydronexus_db
