# API Base URL for backend communications
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Mock Data Mode
# - 'true' (default): instant local dev with bundled mock data, no backend needed.
# - 'false': real backend mode. Requires the backend at VITE_API_BASE_URL
#   (see docs/backend-integration.md). Auth is then enforced via JWT.
VITE_USE_MOCKS=true
