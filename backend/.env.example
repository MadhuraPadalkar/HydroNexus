# Server Configuration
PORT=8000
NODE_ENV=development

# Database Persistence (must match docker-compose database service)
DATABASE_URL=postgres://hydronexus_user:hydronexus_password@localhost:5432/hydronexus_db

# Security & Session Authentication
JWT_SECRET=replace_with_64_character_cryptographically_secure_random_key
JWT_EXPIRES_IN=7d

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# SMS Gateway (for Citizen OTP Login)
SMS_GATEWAY_API_KEY=mock_dev_sms_key_12345
SMS_SENDER_ID=KMCWAT
